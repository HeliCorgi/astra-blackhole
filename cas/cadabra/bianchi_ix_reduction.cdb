# Bianchi IX GR reduction audit.
# Executed by pinned Cadabra 2.5.14. Cadabra's scalar backend is SymPy;
# the Euler-angle metric is constructed independently of repository code and
# Christoffel/Ricci components are computed in this Cadabra process.

import json
from pathlib import Path
import sympy as sp

# Probe the Cadabra scalar backend explicitly.
{th}::Coordinate;
probe := \sin(th)**2 + \cos(th)**2;
map_sympy(probe, "simplify");
probe_sym = sp.simplify(SympyBridge(probe).to_sympy())
if probe_sym != 1:
    raise RuntimeError("Cadabra SymPy bridge probe failed: %s" % probe_sym)

th,ph,ps=sp.symbols("th ph ps", real=True)
a,b,c=sp.symbols("a b c", positive=True, nonzero=True)
coords=(th,ph,ps)

# SU(2) left-invariant one-forms sigma_i, with omega_i=sigma_i/2.
# The corresponding coordinate metric h = sum_i a_i^2 omega_i^2.
h=sp.Matrix([
 [
  (a**2*sp.cos(ps)**2+b**2*sp.sin(ps)**2)/4,
  (a**2-b**2)*sp.cos(ps)*sp.sin(ps)*sp.sin(th)/4,
  0
 ],
 [
  (a**2-b**2)*sp.cos(ps)*sp.sin(ps)*sp.sin(th)/4,
  ((a**2*sp.sin(ps)**2+b**2*sp.cos(ps)**2)*sp.sin(th)**2+c**2*sp.cos(th)**2)/4,
  c**2*sp.cos(th)/4
 ],
 [0,c**2*sp.cos(th)/4,c**2/4]
])
hi=sp.simplify(h.inv())

n=3
Gamma=[[[sp.Integer(0) for _ in range(n)] for _ in range(n)] for _ in range(n)]
for i in range(n):
    for j in range(n):
        for k in range(n):
            val=sp.Integer(0)
            for l in range(n):
                val += hi[i,l]*(
                    sp.diff(h[l,j],coords[k])+
                    sp.diff(h[l,k],coords[j])-
                    sp.diff(h[j,k],coords[l])
                )/2
            Gamma[i][j][k]=sp.trigsimp(sp.simplify(val))

Ric=sp.MutableDenseMatrix(n,n,[0]*(n*n))
for j in range(n):
    for l in range(n):
        val=sp.Integer(0)
        for i in range(n):
            val += sp.diff(Gamma[i][j][l],coords[i])
            val -= sp.diff(Gamma[i][j][i],coords[l])
            for m in range(n):
                val += Gamma[i][i][m]*Gamma[m][j][l]
                val -= Gamma[i][l][m]*Gamma[m][j][i]
        Ric[j,l]=sp.trigsimp(sp.simplify(val))

r3=sp.Integer(0)
for j in range(n):
    for l in range(n):
        r3 += hi[j,l]*Ric[j,l]
r3=sp.factor(sp.trigsimp(sp.simplify(r3)))

closed=sp.factor(
  2*(-a**4-b**4-c**4+2*(a**2*b**2+b**2*c**2+c**2*a**2))/(a**2*b**2*c**2)
)
curvature_closed_delta=sp.simplify(r3-closed)
if curvature_closed_delta != 0:
    raise RuntimeError(
      "spatial Ricci scalar did not reduce to the diagonal Bianchi IX closed form: %s"
      % curvature_closed_delta
    )

alpha,bp,bm=sp.symbols("alpha beta_plus beta_minus", real=True)
sq3=sp.sqrt(3)
aa=sp.exp(alpha+bp+sq3*bm)
bb=sp.exp(alpha+bp-sq3*bm)
cc=sp.exp(alpha-2*bp)
rmis=sp.simplify(closed.subs({a:aa,b:bb,c:cc}))
V=(
 sp.exp(-8*bp)
 +2*sp.exp(4*bp)*(sp.cosh(4*sq3*bm)-1)
 -4*sp.exp(-2*bp)*sp.cosh(2*sq3*bm)
)/6
curvature_misner_delta=sp.simplify(
 sp.expand((rmis+12*sp.exp(-2*alpha)*V).rewrite(sp.exp))
)
if curvature_misner_delta != 0:
    raise RuntimeError("R3 != -12 exp(-2 alpha) V: %s" % curvature_misner_delta)

N=sp.symbols("N", positive=True)
ad,bpd,bmd=sp.symbols("alpha_dot beta_plus_dot beta_minus_dot", real=True)
db1=bpd+sq3*bmd
db2=bpd-sq3*bmd
db3=-2*bpd
k1=(ad+db1)/N
k2=(ad+db2)/N
k3=(ad+db3)/N
kin=sp.factor(k1**2+k2**2+k3**2-(k1+k2+k3)**2)
kin_expected=6*(-ad**2+bpd**2+bmd**2)/N**2
kinetic_delta=sp.simplify(kin-kin_expected)
if kinetic_delta != 0:
    raise RuntimeError("ADM kinetic invariant mismatch: %s" % kinetic_delta)

# R3=-12 exp(-2 alpha)V. Drop the common spatial-volume/(2 kappa)
# factor and divide the reduced ADM expression by 12 to match the repository
# canonical normalization.
L=sp.exp(3*alpha)/(2*N)*(-ad**2+bpd**2+bmd**2)-N*sp.exp(alpha)*V
pa,pp,pm=sp.symbols("p_alpha p_plus p_minus", real=True)
momenta={
 "p_alpha":sp.diff(L,ad),
 "p_plus":sp.diff(L,bpd),
 "p_minus":sp.diff(L,bmd),
}
vel={
 ad:-N*sp.exp(-3*alpha)*pa,
 bpd:N*sp.exp(-3*alpha)*pp,
 bmd:N*sp.exp(-3*alpha)*pm,
}
H=sp.simplify((pa*ad+pp*bpd+pm*bmd-L).subs(vel))
C=sp.simplify(H/N)
C_expected=sp.exp(-3*alpha)*(-pa**2+pp**2+pm**2)/2+sp.exp(alpha)*V
constraint_delta=sp.simplify(sp.expand((C-C_expected).rewrite(sp.exp)))
if constraint_delta != 0:
    raise RuntimeError("Hamiltonian constraint mismatch: %s" % constraint_delta)

s=sp.symbols("s", real=True)
W=sp.simplify(2*sp.exp(-4*s)*V)
wall_terms=[
 ("1/3",-4,-8,0),
 ("1/3",-4,4,4),
 ("1/3",-4,4,-4),
 ("-2/3",-4,4,0),
 ("-2/3",-4,-2,2),
 ("-2/3",-4,-2,-2),
]

result={
 "schema":1,
 "backend":{
   "name":"Cadabra",
   "version":"2.5.14",
   "mode":"cadabra2-cli with Cadabra SymPy scalar backend; explicit Euler-angle component GR calculation"
 },
 "checks":{
   "cadabra_sympy_bridge_probe":str(sp.simplify(probe_sym-1)),
   "spatial_curvature_closed_form_zero":str(curvature_closed_delta),
   "spatial_curvature_misner_zero":str(curvature_misner_delta),
   "adm_kinetic_zero":str(kinetic_delta),
   "constraint_zero":str(constraint_delta),
 },
 "derived":{
   "spatial_curvature_closed":sp.sstr(closed),
   "spatial_curvature_relation":"R3=-12*exp(-2*alpha)*V",
   "adm_kinetic_invariant":"6/N**2*(-alpha_dot**2+beta_plus_dot**2+beta_minus_dot**2)",
   "normalized_lagrangian":sp.sstr(L),
   "momenta":{k:sp.sstr(v) for k,v in momenta.items()},
   "constraint":sp.sstr(C),
   "reduced_s_generator":"-sqrt(p_plus**2+p_minus**2+W)",
   "W":sp.sstr(W),
   "wall_terms":[
      {"coefficient":coef,"s":se,"beta_plus":pe,"sqrt3_beta_minus":me}
      for coef,se,pe,me in wall_terms
   ]
 },
 "conventions":{
   "omega_normalization":"omega_i=sigma_i/2",
   "misner_scale_factors":[
      "exp(alpha+beta_plus+sqrt(3)*beta_minus)",
      "exp(alpha+beta_plus-sqrt(3)*beta_minus)",
      "exp(alpha-2*beta_plus)"
   ],
   "extrinsic_curvature_sign":"K_ij=+(1/(2N))*dot(h_ij); quadratic invariant insensitive to global sign",
   "normalized_adm_factor":"1/12 after dropping the common spatial-volume/(2 kappa) factor"
 }
}
out=Path("artifacts/gr-reduction")
out.mkdir(parents=True,exist_ok=True)
(out/"cadabra_result.json").write_text(json.dumps(result,indent=2,sort_keys=True)+"\n")
print("ASTRA_CADABRA_BIANCHI_IX_OK")
print(json.dumps(result,sort_keys=True))
