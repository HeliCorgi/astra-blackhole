# Bianchi IX GR reduction audit.
# Executed by cadabra2-cli. The spatial Ricci scalar is computed from the
# Euler-angle coordinate metric using Cadabra component tensor algorithms.
# The remaining ADM/Legendre algebra is performed inside the same Cadabra
# process through its SymPy bridge / Python layer.

import json
from pathlib import Path
import sympy as sp

{th,ph,ps}::Coordinate;
{\mu,\nu,\rho,\sigma,\lambda,\kappa}::Indices(values={th,ph,ps}, position=fixed);
\partial{#}::PartialDerivative;
h_{\mu\nu}::Metric.
h^{\mu\nu}::InverseMetric.

metric := {
 h_{th th} = 1/4*(a**2*\cos(ps)**2 + b**2*\sin(ps)**2),
 h_{th ph} = 1/4*(a**2-b**2)*\cos(ps)*\sin(ps)*\sin(th),
 h_{ph th} = 1/4*(a**2-b**2)*\cos(ps)*\sin(ps)*\sin(th),
 h_{th ps} = 0,
 h_{ps th} = 0,
 h_{ph ph} = 1/4*((a**2*\sin(ps)**2+b**2*\cos(ps)**2)*\sin(th)**2+c**2*\cos(th)**2),
 h_{ph ps} = 1/4*c**2*\cos(th),
 h_{ps ph} = 1/4*c**2*\cos(th),
 h_{ps ps} = 1/4*c**2
};
complete(metric, $h^{\mu\nu}$);

ch := \Gamma^{\mu}_{\nu\rho} = 1/2 h^{\mu\sigma}(
       \partial_{\rho}{h_{\sigma\nu}} + \partial_{\nu}{h_{\sigma\rho}} - \partial_{\sigma}{h_{\nu\rho}}
      );
evaluate(ch, metric, rhsonly=True);

rm := R^{\rho}_{\sigma\mu\nu} =
      \partial_{\mu}{\Gamma^{\rho}_{\sigma\nu}} - \partial_{\nu}{\Gamma^{\rho}_{\sigma\mu}}
      + \Gamma^{\rho}_{\lambda\mu}\Gamma^{\lambda}_{\sigma\nu}
      - \Gamma^{\rho}_{\lambda\nu}\Gamma^{\lambda}_{\sigma\mu};
substitute(rm, ch);
evaluate(rm, metric, rhsonly=True);

ricci := R_{\sigma\nu} = R^{\rho}_{\sigma\rho\nu};
substitute(ricci, rm);
evaluate(ricci, metric, rhsonly=True);

R3 := R_{\sigma\nu} h^{\sigma\nu};
substitute(R3, ricci);
evaluate(R3, metric);
map_sympy(R3, "simplify");

r3 = sp.simplify(SympyBridge(R3).to_sympy())
a_s,b_s,c_s = sp.symbols("a b c", positive=True)
closed = sp.simplify(2*(-a_s**4-b_s**4-c_s**4+2*(a_s**2*b_s**2+b_s**2*c_s**2+c_s**2*a_s**2))/(a_s**2*b_s**2*c_s**2))
curvature_closed_delta = sp.simplify(r3-closed)
if curvature_closed_delta != 0:
    raise RuntimeError("Cadabra spatial Ricci scalar did not reduce to the diagonal Bianchi IX closed form: %s" % curvature_closed_delta)

alpha,bp,bm = sp.symbols("alpha beta_plus beta_minus", real=True)
sq3=sp.sqrt(3)
aa=sp.exp(alpha+bp+sq3*bm)
bb=sp.exp(alpha+bp-sq3*bm)
cc=sp.exp(alpha-2*bp)
rmis=sp.simplify(closed.subs({a_s:aa,b_s:bb,c_s:cc}))
V=(sp.exp(-8*bp)+2*sp.exp(4*bp)*(sp.cosh(4*sq3*bm)-1)-4*sp.exp(-2*bp)*sp.cosh(2*sq3*bm))/6
curvature_misner_delta=sp.simplify(sp.expand((rmis+12*sp.exp(-2*alpha)*V).rewrite(sp.exp)))
if curvature_misner_delta != 0:
    raise RuntimeError("R3 != -12 exp(-2 alpha) V: %s" % curvature_misner_delta)

N=sp.symbols("N", positive=True)
ad,bpd,bmd=sp.symbols("alpha_dot beta_plus_dot beta_minus_dot", real=True)
db1=bpd+sq3*bmd
db2=bpd-sq3*bmd
db3=-2*bpd
k1=(ad+db1)/N
k2=(ad+db2)/N
k3=(ad+db3)/N
kin=sp.factor(k1**2+k2**2+k3**2-(k1+k2+k3)**2)
kin_expected=6*(-ad**2+bpd**2+bmd**2)/N**2
kinetic_delta=sp.simplify(kin-kin_expected)
if kinetic_delta != 0:
    raise RuntimeError("ADM kinetic invariant mismatch: %s" % kinetic_delta)

# With R3=-12 exp(-2 alpha)V, dividing the common integrated ADM
# expression by 12 gives exactly the repository normalization.
L=sp.exp(3*alpha)/(2*N)*(-ad**2+bpd**2+bmd**2)-N*sp.exp(alpha)*V
pa,pp,pm=sp.symbols("p_alpha p_plus p_minus", real=True)
momenta={
    "p_alpha":sp.diff(L,ad),
    "p_plus":sp.diff(L,bpd),
    "p_minus":sp.diff(L,bmd),
}
vel={
    ad:-N*sp.exp(-3*alpha)*pa,
    bpd:N*sp.exp(-3*alpha)*pp,
    bmd:N*sp.exp(-3*alpha)*pm,
}
H=sp.simplify((pa*ad+pp*bpd+pm*bmd-L).subs(vel))
C=sp.simplify(H/N)
C_expected=sp.exp(-3*alpha)*(-pa**2+pp**2+pm**2)/2+sp.exp(alpha)*V
constraint_delta=sp.simplify(sp.expand((C-C_expected).rewrite(sp.exp)))
if constraint_delta != 0:
    raise RuntimeError("Hamiltonian constraint mismatch: %s" % constraint_delta)

s=sp.symbols("s", real=True)
W=sp.simplify(2*sp.exp(-4*s)*V)
wall_terms=[
    ("1/3",-4,-8,0),
    ("1/3",-4,4,4),
    ("1/3",-4,4,-4),
    ("-2/3",-4,4,0),
    ("-2/3",-4,-2,2),
    ("-2/3",-4,-2,-2),
]

result={
 "schema":1,
 "backend":{"name":"Cadabra","mode":"cadabra2-cli component curvature + SymPy bridge algebra"},
 "checks":{
   "spatial_curvature_closed_form_zero":str(curvature_closed_delta),
   "spatial_curvature_misner_zero":str(curvature_misner_delta),
   "adm_kinetic_zero":str(kinetic_delta),
   "constraint_zero":str(constraint_delta),
 },
 "derived":{
   "spatial_curvature_closed":sp.sstr(closed),
   "spatial_curvature_relation":"R3=-12*exp(-2*alpha)*V",
   "adm_kinetic_invariant":"6/N**2*(-alpha_dot**2+beta_plus_dot**2+beta_minus_dot**2)",
   "normalized_lagrangian":sp.sstr(L),
   "momenta":{k:sp.sstr(v) for k,v in momenta.items()},
   "constraint":sp.sstr(C),
   "reduced_s_generator":"-sqrt(p_plus**2+p_minus**2+W)",
   "W":sp.sstr(W),
   "wall_terms":[
      {"coefficient":coef,"s":se,"beta_plus":pe,"sqrt3_beta_minus":me}
      for coef,se,pe,me in wall_terms
   ]
 },
 "conventions":{
   "omega_normalization":"omega_i=sigma_i/2",
   "misner_scale_factors":[
      "exp(alpha+beta_plus+sqrt(3)*beta_minus)",
      "exp(alpha+beta_plus-sqrt(3)*beta_minus)",
      "exp(alpha-2*beta_plus)"
   ],
   "extrinsic_curvature_sign":"K_ij=+(1/(2N))*dot(h_ij); quadratic invariant insensitive to global sign",
   "normalized_adm_factor":"1/12 after dropping the common spatial-volume/(2 kappa) factor"
 }
}
out=Path("artifacts/gr-reduction")
out.mkdir(parents=True,exist_ok=True)
(out/"cadabra_result.json").write_text(json.dumps(result,indent=2,sort_keys=True)+"\n")
print("ASTRA_CADABRA_BIANCHI_IX_OK")
print(json.dumps(result,sort_keys=True))
